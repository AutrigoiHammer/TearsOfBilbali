      </characteristics>
    </profile>
    <profile name="Merwyrm" typeId="b070-143a-73f-2772" typeName="Model" hidden="false" id="4cdb-9bff-4a9d-6379">
      <characteristics>
        <characteristic name="M" typeId="cd3b-a5a4-e185-5a9d">6</characteristic>
        <characteristic name="WS" typeId="b007-7d58-4f14-1e01">6</characteristic>
        <characteristic name="BS" typeId="59f9-ccf5-1155-fb05">0</characteristic>
        <characteristic name="S" typeId="5b6b-1427-2a45-dd0c">6</characteristic>
        <characteristic name="T" typeId="ab43-8b61-83e7-d090">6</characteristic>
        <characteristic name="W" typeId="83ed-7b82-bf1f-e558">6</characteristic>
        <characteristic name="I" typeId="73b1-abe5-72f8-41e2">3</characteristic>
        <characteristic name="A" typeId="dddc-9fbd-b0fd-a480">4</characteristic>
        <characteristic name="Ld" typeId="c435-6b14-f77e-3c72">8</characteristic>
      </characteristics>
    </profile>
    <profile name="Enfeebling Cold" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="886a-db9e-80f9-93c8">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">Whilst in base contact with this model, enemy models suffer a -1 modifier to their Strength characteristic (to a minimum of 1).</characteristic>
      </characteristics>
    </profile>
    <profile name="Abyssal Cloak" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="1c32-9aec-fd96-246b">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">Any enemy model that targets this model during the Shooting phase suffers a -2 To Hit modifier for firing at long range, rather than the usual -1.</characteristic>
      </characteristics>
    </profile>
    <profile name="Bloodshield of Khaine" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="c5df-6c77-def5-80f8">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">This model and any unit joined by the Cauldron of Blood has a 5+ Ward save against any wounds suffered.</characteristic>
      </characteristics>
    </profile>
    <profile name="If One Head is Severed… Another Takes Its Place (Renegades 1.5.2.1)" typeId="d6d5-bc1d-f0d9-ec55" typeName="Special Rule" hidden="false" id="f8bb-c9be-c46f-8c46">
      <characteristics>
        <characteristic name="Description" typeId="fbf8-7d6-6e1f-79ee">In your Command sub-phase roll a D6 for each wound that the War Hydra has lost. On each roll of a 4+ the War Hydra immediately recovers a wound.</characteristic>
      </characteristics>
    </profile>
    <profile name="Shield of Ghrond (Renegades 1.5.2.1)" typeId="fefe-6a57-a203-edf9" typeName="Magic Armour" hidden="false" id="a742-23d3-867a-5e2e">
      <characteristics>
        <characteristic name="Description" typeId="d6b2-9b2a-d88e-eec9">The Shield of Ghrond is a shield. In addition, all attacks directed against its bearer suffer a -1 modifier to their Strength characteristic (to a minimum of 1)</characteristic>
      </characteristics>
    </profile>
    <profile name="Banner Of Nagarythe (Renegades 1.5.2.1)" typeId="e3be-1b80-f570-96a1" typeName="Magic Standards" hidden="false" id="126f-db08-846b-4457">
      <characteristics>
        <characteristic name="Description" typeId="a34c-cc25-6cb9-95e1">A unit carrying the Banner of Nagarythe gains the Stubborn special rule. In addition, when calculating its combat result, the unit may claim an additional bonus of +1 combat result point.</characteristic>
      </characteristics>
    </profile>
    <profile name="Tome of Furion (Renegades 1.5.2.1)" typeId="65d6-7512-2a53-bd6c" typeName="Arcane Items" hidden="false" id="717f-96ab-1a1e-7935">
      <characteristics>
        <characteristic name="Description" typeId="fdd8-b367-1d68-c9cd">The bearer of the Tome of Furion knows one more spell (chosen in the usual way) than is normal for their Level of Wizardry.</characteristic>
      </characteristics>
    </profile>
    <profile name="Black Dragon Egg (Renegades 1.5.2.1)" typeId="d29c-a3fb-dcdf-29d6" typeName="Enchanted Items" hidden="false" id="c232-f29a-1a7b-7fc4">
      <characteristics>
        <characteristic name="Description" typeId="cea7-7573-475d-cc1d">Single use. During the Command sub-phase of their turn, the bearer of a Black Dragon Egg can consume it. Until your next Command sub-phase, the model has a Toughness characteristic of 6 (which cannot be improved further) and gains noxious breath (see page 18).</characteristic>
      </characteristics>
    </profile>
    <profile name="Lore of Naggaroth (Renegades 1.5.2.1)" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="c120-9f78-6292-a031">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">A Wizard with the ‘Lore of Naggaroth’ special rule may discard one of their randomly generated spells as normal. When they do so, they may select instead either the signature spell of their chosen Lore of Magic, or one of the spells listed below:


• Cursing Word
• Black Horror
• Power of Darkness</characteristic>
      </characteristics>
    </profile>
    <profile name="Loner (Dark Elves)" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="7138-0e01-bda9-66c4">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">Dark Elf characters cannot join units of Mortal Chaos or Daemons. Aspiring Champions cannot join units of Dark Elves or Daemons.</characteristic>
      </characteristics>
    </profile>
    <profile name="Loner (Daemons)" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="b89d-476e-d494-9573">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">Daemons cannot join units of Dark Elves or Mortal Chaos.</characteristic>
      </characteristics>
    </profile>
    <profile name="Dark Elves Mark of Slaanesh" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="1c36-5d3d-8e23-4c0a">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">Dark Elves with the Mark of Slaanesh still have hatred of High Elves. Units or characters with the Mark of Slaanesh and riding Cold Ones are still subject to Stupidity special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Sorceress Mark of Slaanesh" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="53a6-ff66-66a5-94ed">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">Sorceresses with the the Mark of Slaanesh must use Daemonology or Dark Magic, and have +1 to cast their spells.</characteristic>
      </characteristics>
    </profile>
    <profile name="Marks of the Dark Gods" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="9402-9c38-4122-5c1b">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">All rules for Marks of the Dark Gods apply.</characteristic>
      </characteristics>
    </profile>
    <profile name="Unchaosed Dark Elf Items" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="1efd-7131-0f4f-ffe5">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">Chaos characters and units may not use Dark Elf magic items</characteristic>
      </characteristics>
    </profile>
    <profile name="Draich of Dark Power" typeId="e4d1-790a-ab75-2b57" typeName="Magic Weapons" hidden="false" id="f5a1-d196-d4f6-d2e2">
      <characteristics>
        <characteristic name="R" typeId="51c8-c0d6-94db-264c">Combat</characteristic>
        <characteristic name="S" typeId="4f75-25c9-31bd-7074">S+2</characteristic>
        <characteristic name="AP" typeId="15e2-fff4-477f-ea26">-2</characteristic>
        <characteristic name="Special Rules" typeId="57a7-47c0-8d74-d54c">Killing Blow. Uses two hands.</characteristic>
        <characteristic name="Note" typeId="5e5e-34db-1ee0-86"/>
      </characteristics>
    </profile>
    <profile name="Blade of Spite" typeId="e4d1-790a-ab75-2b57" typeName="Magic Weapons" hidden="false" id="e70b-4ba2-f2e1-f5d7">
      <characteristics>
        <characteristic name="R" typeId="51c8-c0d6-94db-264c">Combat</characteristic>
        <characteristic name="S" typeId="4f75-25c9-31bd-7074">S</characteristic>
        <characteristic name="AP" typeId="15e2-fff4-477f-ea26">-</characteristic>
        <characteristic name="Special Rules" typeId="57a7-47c0-8d74-d54c"/>
        <characteristic name="Note" typeId="5e5e-34db-1ee0-86">Any rolls to hit of a 5 or 6 wound automatically, with no need to roll to wound</characteristic>
      </characteristics>
    </profile>
    <profile name="Heartstone of Darkness" typeId="5c1d-13f3-7dd6-e817" typeName="Talismans" hidden="false" id="ff46-f8e3-5070-c4fe">
      <characteristics>
        <characteristic name="Description" typeId="3fa5-c856-b00a-c9f4">The bearer has a 4+ Ward Save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Wand of the Kharaidon (Renegades 1.5.2.1 + Cult of Slaanesh)" typeId="d29c-a3fb-dcdf-29d6" typeName="Enchanted Items" hidden="false" id="70e3-9eba-c4cf-2607">
      <characteristics>
        <characteristic name="Description" typeId="cea7-7573-475d-cc1d">Once per turn, the wielder may unleash the power of the Wand. Doombolt spell can be casted with Power Level of 2.

Each time it is used, roll a dice: on 1 its power is exhausted, and it cannot be used for the remainder of the game.</characteristic>
      </characteristics>
    </profile>
    <profile name="The Cloak of the Dark Souls (Renegades 1.5.2.1 + Cult of Slaanesh)" typeId="d29c-a3fb-dcdf-29d6" typeName="Enchanted Items" hidden="false" id="17ab-3c24-ac25-3fc9">
      <characteristics>
        <characteristic name="Description" typeId="cea7-7573-475d-cc1d">A character with the Cloak of the Dark Souls may Scout, so long as they are on foot</characteristic>
      </characteristics>
    </profile>
    <profile name="Soul Shadows Standard (Renegades 1.5.2.1 + Cult of Slaanesh)" typeId="e3be-1b80-f570-96a1" typeName="Magic Standards" hidden="false" id="83be-b86b-3549-99d7">
      <characteristics>
        <characteristic name="Description" typeId="a34c-cc25-6cb9-95e1">A unit carrying the Banner of Nagarythe gains the Stubborn special rule. In addition, when calculating its combat result, the unit may claim an additional bonus of +1 combat result point.</characteristic>
      </characteristics>
    </profile>
    <profile name="Rapturous Standard (Renegades 1.5.2.1 + Cult of Slaanesh)" typeId="e3be-1b80-f570-96a1" typeName="Magic Standards" hidden="false" id="2e9d-3f8d-bdb1-6b01">
      <characteristics>
        <characteristic name="Description" typeId="a34c-cc25-6cb9-95e1">Characters or units with Mark of Slaanesh only. The model and any unit he is with count as having the Daemonic Gift - Soporific Musk, meaning any model in base contact with one or more Daemons with Soporific Musk halve their WS and I (rounding up). This can also be used in a Dark Elf unit with the Mark of Slaanesh.</characteristic>
      </characteristics>
    </profile>
    <profile name="Quickening Blood" typeId="d5be-a811-c59d-cf37" typeName="Anointed Daemonic Gifts" hidden="false" id="0872-e2de-7e6e-a581">
      <characteristics>
        <characteristic name="Description" typeId="7e40-684d-cc8f-0f0a">The Anointed always strikes first in combat, even if changed or armed with a weapon that normally strikes last. If any of the Anointed opponents also Strike First, revert to normal Initiative (both opponents lose Strike First for that round of combat).</characteristic>
      </characteristics>
    </profile>
    <profile name="Avatar of Slaanesh" typeId="d5be-a811-c59d-cf37" typeName="Anointed Daemonic Gifts" hidden="false" id="a179-102c-e2d2-f9a0">
      <characteristics>
        <characteristic name="Description" typeId="7e40-684d-cc8f-0f0a">Any unit with the Mark of Slaanesh (including the Anointed himself) within 12&quot; may re-roll any failed Break tests</characteristic>
      </characteristics>
    </profile>
    <profile name="Allure of Slaanesh" typeId="d5be-a811-c59d-cf37" typeName="Anointed Daemonic Gifts" hidden="false" id="18b9-9bad-b0cb-ce04">
      <characteristics>
        <characteristic name="Description" typeId="7e40-684d-cc8f-0f0a">Any unit wishing to shoot the Anointed (or any unit he has joined) must first pass a Leadership test. If this test if failed, the unit may not shoot that turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="Druchii Anointed" typeId="b070-143a-73f-2772" typeName="Model" hidden="false" id="df0d-5887-f446-3425">
      <characteristics>
        <characteristic name="M" typeId="cd3b-a5a4-e185-5a9d">6</characteristic>
        <characteristic name="WS" typeId="b007-7d58-4f14-1e01">8</characteristic>
        <characteristic name="BS" typeId="59f9-ccf5-1155-fb05">7</characteristic>
        <characteristic name="S" typeId="5b6b-1427-2a45-dd0c">5</characteristic>
        <characteristic name="T" typeId="ab43-8b61-83e7-d090">4</characteristic>
        <characteristic name="W" typeId="83ed-7b82-bf1f-e558">3</characteristic>
        <characteristic name="I" typeId="73b1-abe5-72f8-41e2">9</characteristic>
        <characteristic name="A" typeId="dddc-9fbd-b0fd-a480">5</characteristic>
        <characteristic name="Ld" typeId="c435-6b14-f77e-3c72">9</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
