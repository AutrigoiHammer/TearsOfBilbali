    </profile>
    <profile name="Cry of War" typeId="d6d5-bc1d-f0d9-ec55" typeName="Special Rule" hidden="false" id="a016-7f5e-e8a2-e2a4">
      <characteristics>
        <characteristic name="Description" typeId="fbf8-7d6-6e1f-79ee">Enemy units suffer a -1 modifier to their Leadership characteristic whilst within the Command range of one or more Death Hags that have this special rule and that are not fleeing.</characteristic>
