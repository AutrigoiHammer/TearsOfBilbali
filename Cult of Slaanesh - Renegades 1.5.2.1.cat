      </characteristics>
    </profile>
    <profile name="Petrifying gaze" typeId="a378-c633-912d-11ce" typeName="Weapon" hidden="false" id="fca5-fa1d-aff2-e333">
      <characteristics>
        <characteristic name="R" typeId="2360-c777-5e07-ed58">18&quot;</characteristic>
        <characteristic name="S" typeId="ac19-f99c-72e9-a1a7">2</characteristic>
        <characteristic name="AP" typeId="9429-ffe7-2ce5-e9a5">N/A</characteristic>
        <characteristic name="Special Rules" typeId="5f83-3633-336b-93b4">Magical Attacks, Multiple Wounds (D3)</characteristic>
        <characteristic name="Notes" typeId="772a-a7ff-f6b3-df71">When making a roll To Wound for an attack made with this weapon, substitute the target’s Toughness with its Initiative. No armour save is permitted against wounds caused by this weapon (Ward and Regeneration saves can be attempted as normal).</characteristic>
      </characteristics>
    </profile>
    <profile name="Noxious breath" typeId="a378-c633-912d-11ce" typeName="Weapon" hidden="false" id="79bb-357e-c31e-d97d">
      <characteristics>
        <characteristic name="R" id="b98e-39d7-b137-d7d2" hidden="false" typeId="2360-c777-5e07-ed58">N/A</characteristic>
        <characteristic name="S" id="2c90-1c79-778a-5ea9" hidden="false" typeId="ac19-f99c-72e9-a1a7">4</characteristic>
        <characteristic name="AP" id="ae7c-9512-3109-4d4b" hidden="false" typeId="9429-ffe7-2ce5-e9a5">N/A</characteristic>
        <characteristic name="Special Rules" id="bda4-7f56-3784-6331" hidden="false" typeId="5f83-3633-336b-93b4">Breath Weapon</characteristic>
        <characteristic name="Notes" id="de32-8dac-caa3-f346" hidden="false" typeId="772a-a7ff-f6b3-df71">Until your next Start of Turn sub-phase, every model in a unit that suffers one or more unsaved wounds from this weapon suffers a -1 modifier to its Weapon Skill characteristic (to a minimum of 1). No armour save is permitted against wounds caused by this weapon (Ward and Regeneration saves can be attempted as normal).</characteristic>
      </characteristics>
    </profile>
    <profile name="Venomous tail" typeId="a378-c633-912d-11ce" typeName="Weapon" hidden="false" id="6b98-351a-70d3-5a64">
      <characteristics>
        <characteristic name="R" typeId="2360-c777-5e07-ed58">Combat</characteristic>
        <characteristic name="S" typeId="ac19-f99c-72e9-a1a7">S</characteristic>
