          </infoLinks>
          <profiles>
            <profile name="Deploying Weapon Teams" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="f6ea-a15e-39b5-5094">
              <characteristics>
                <characteristic name="Description" typeId="9f84-4221-785a-db50">A Weapon Team must be deployed at the same time as its ‘parent’ unit (the unit it was bought as an upgrade for), and must be deployed within 3&quot; of that unit</characteristic>
              </characteristics>
            </profile>
            <profile name="Weapon Team Leadership" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="12ac-e7d2-dc24-b601">
              <characteristics>
                <characteristic name="Description" typeId="9f84-4221-785a-db50">Whilst within 3&quot; of its parent unit, a Weapon Team gains a positive (+) modifier to its Leadership characteristic equal to the parent unit’s current Rank Bonus, up to a maximum of Leadership 10.</characteristic>
              </characteristics>
            </profile>
            <profile name="Targeting Weapon Teams" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="98a7-0488-085a-4346">
              <characteristics>
                <characteristic name="Description" typeId="9f84-4221-785a-db50">If it is within 3&quot; of its parent unit, and if that unit contains five or more models (and is not itself fleeing), a Weapon Team cannot be targeted by enemy shooting or by enemy spells, unless the Weapon Team is the closest target.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
      </infoGroups>
      <categoryLinks>
        <categoryLink name="Faction: Skaven" hidden="false" id="dd77-b7a5-8d52-73dc" primary="false" targetId="ed3f-1102-3044-59f5"/>
      </categoryLinks>
    </selectionEntry>
  </sharedSelectionEntries>
