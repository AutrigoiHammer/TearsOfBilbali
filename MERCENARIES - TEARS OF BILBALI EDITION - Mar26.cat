    </profile>
    <profile name="Borgio the Besieger" id="4961-db8a-8e6a-4eb6" hidden="false" page="Army Book of Dogs of War in Warhammer Fantasy 5th Edition" typeId="b070-143a-73f-2772" typeName="Model">
      <characteristics>
        <characteristic name="M" typeId="cd3b-a5a4-e185-5a9d">-</characteristic>
