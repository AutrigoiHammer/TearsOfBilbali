    <profile name="Gromril Armour" id="241f-51fc-3735-4add" hidden="false" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">A model with this special rule may re-roll any roll of a natural 1 made when making an Armour Save roll</characteristic>
      </characteristics>
    </profile>
    <profile name="Merchant&apos;s Fate" id="6a9b-c9db-a743-7b84" hidden="false" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">For each objective marker a player controls at the end of each player&apos;s turn, they win an additional bonus of 10 Victory Points if Gorim Baldor is inside the unit controlling such objective marker.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
