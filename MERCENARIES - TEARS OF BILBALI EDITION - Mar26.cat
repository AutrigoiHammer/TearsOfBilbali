    <profile name="Tichi Uichi&apos;s Cold Ones" id="70fe-ed8b-942c-152b" hidden="false" page="Dogs of War Army List, Warhammer Fantasy 5th Edition, Adapted for ToW" typeId="b070-143a-73f-2772" typeName="Model">
      <characteristics>
        <characteristic name="M" typeId="cd3b-a5a4-e185-5a9d">8</characteristic>
