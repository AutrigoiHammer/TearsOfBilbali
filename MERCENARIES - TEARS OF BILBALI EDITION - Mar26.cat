    <profile name="Mercenary Crew" id="e5cd-a243-4ee4-ee7d" hidden="false" typeId="b070-143a-73f-2772" typeName="Model">
      <comment>Pikemen from Pirazzo&apos;s Lost Legion from 6th Edition</comment>
      <characteristics>
        <characteristic name="M" typeId="cd3b-a5a4-e185-5a9d">4</characteristic>
        <characteristic name="WS" typeId="b007-7d58-4f14-1e01">3</characteristic>
        <characteristic name="BS" typeId="59f9-ccf5-1155-fb05">3</characteristic>
