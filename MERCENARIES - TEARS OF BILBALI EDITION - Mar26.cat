    <profile name="Grimacing Death Mask" id="7441-662a-5748-0216" hidden="false" typeId="d29c-a3fb-dcdf-29d6" typeName="Enchanted Items">
      <characteristics>
        <characteristic name="Description" typeId="cea7-7573-475d-cc1d">All enemy models in base contact with Vespero lose one attack in the first round of Close Combat. Yes, models with one attack would have zero attacks in this regard. This has no effect on models with Immunity (Psychology) special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Sir John Tyreweld" id="a626-ce53-15d9-4f4b" hidden="false" page="The Citadel Journal, Spring 1985 (2nd Edition)" typeId="b070-143a-73f-2772" typeName="Model">
      <characteristics>
        <characteristic name="M" typeId="cd3b-a5a4-e185-5a9d">4</characteristic>
