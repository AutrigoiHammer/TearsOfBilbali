    <profile name="Bear Banner" id="0d9f-638c-fb8c-2823" hidden="false" typeId="e3be-1b80-f570-96a1" typeName="Magic Standards">
      <characteristics>
        <characteristic name="Description" typeId="a34c-cc25-6cb9-95e1">Oerl carries the tribe&apos;s totem into battle, which is an entire bear skin whose grizzly head leers out from the top. The skin&apos;s power is immense, driving the warriors into a fury that is almost impossible to stop. To represent this, the entire unit receives a +1 to hit bonus in the initial round of each hand-to-hand combat.</characteristic>
      </characteristics>
    </profile>
    <profile name="Bear Fang Talisman" id="9dba-7774-7373-1aa4" hidden="false" typeId="5c1d-13f3-7dd6-e817" typeName="Talismans">
      <characteristics>
        <characteristic name="Description" typeId="3fa5-c856-b00a-c9f4">This gigantic and ancient yellowed canine tooth is the sacred talisman of lordship amongst Beorg&apos;s tribe. Beorg wears it about his neck. It gives him a 4+ Ward Save against all wounds inflicted.</characteristic>
      </characteristics>
    </profile>
    <profile name="Jagged Claws" id="97d1-db84-d78d-8842" hidden="false" typeId="a378-c633-912d-11ce" typeName="Weapon">
