    <profile name="Johann van Hal" id="6c33-2ac1-d9db-5863" hidden="false" page="Regiments of Renown, Warhammer Chronicles 2004, p. 62 (Adapted for Warhammer: The Old World - Tears of Bilbali Edition). By Autrigon Tales." typeId="b070-143a-73f-2772" typeName="Model">
