    <profile name="Shoot on the Wing" id="c2ad-dbfa-36fa-ba72" hidden="false" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">The wings of the Birdmen are flapped by means of stirrups on their feet. This means that they have both hands free to load and shoot their crossbows while flying. This means that the Birdmen suffer no penalty for shooting if they moved by flying (not on foot) during this turn.</characteristic>
      </characteristics>
    </profile>
