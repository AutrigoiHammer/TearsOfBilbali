        <characteristic name="Ld" typeId="c435-6b14-f77e-3c72">8</characteristic>
      </characteristics>
    </profile>
    <profile name="Mixed Formation" id="e6c3-a289-a470-44af" hidden="false" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">Casualties are always removed from the rear so front rank always remains Pirazzo&apos;s Crossbowmen.</characteristic>
      </characteristics>
    </profile>
    <profile name="Pikes" id="2e45-16fb-4849-4905" hidden="false" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">Pikes fight in four ranks; require two hands. Always strikes first in the initial round of close combat, even striking before enemies that have charged. Note that enemies that are entitled to strike first because of a special ability or magic, will strike before pike-armed models.
Models armed with pikes recieve a +1 Strength bonus in the Close Combar phase on turn they are charged by cavalry units, chariots or monsters. Note that this bonus only applies to attacks directed against the above charging units, not against other units.
All these special rules cannot be used against enemy fighting the Pikemen&apos;s flank or rear.</characteristic>
      </characteristics>
    </profile>
    <profile name="Warghan" id="5ef4-7a99-5cb0-ae41" hidden="false" page="https://zharr-naggrund.poderna.com/wp-content/uploads/2019/01/white-dwarf-47.pdf" typeId="b070-143a-73f-2772" typeName="Model">
      <characteristics>
        <characteristic name="M" typeId="cd3b-a5a4-e185-5a9d">8</characteristic>
        <characteristic name="WS" typeId="b007-7d58-4f14-1e01">5</characteristic>
        <characteristic name="BS" typeId="59f9-ccf5-1155-fb05">0</characteristic>
        <characteristic name="S" typeId="5b6b-1427-2a45-dd0c">5</characteristic>
        <characteristic name="T" typeId="ab43-8b61-83e7-d090">-</characteristic>
        <characteristic name="W" typeId="83ed-7b82-bf1f-e558">-</characteristic>
        <characteristic name="I" typeId="73b1-abe5-72f8-41e2">4</characteristic>
