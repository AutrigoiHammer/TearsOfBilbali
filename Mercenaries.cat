        <characteristic name="I" typeId="73b1-abe5-72f8-41e2">3</characteristic>
        <characteristic name="A" typeId="dddc-9fbd-b0fd-a480">1</characteristic>
        <characteristic name="Ld" typeId="c435-6b14-f77e-3c72">7</characteristic>
      </characteristics>
      <comment>Crossbowmen from Pirazzo&apos;s Lost Legion from 6th Edition</comment>
    </profile>
    <profile name="Crossbow (Pirazzo&apos;s Legion)" typeId="a378-c633-912d-11ce" typeName="Weapon" hidden="false" id="0da4-1137-5561-8150">
      <characteristics>
        <characteristic name="R" typeId="2360-c777-5e07-ed58">30</characteristic>
        <characteristic name="S" typeId="ac19-f99c-72e9-a1a7">4</characteristic>
        <characteristic name="AP" typeId="9429-ffe7-2ce5-e9a5">-1</characteristic>
        <characteristic name="Special Rules" typeId="5f83-3633-336b-93b4">Ponderous</characteristic>
        <characteristic name="Notes" typeId="772a-a7ff-f6b3-df71">Crossbows from Pirazzo&apos;s Legion can be used although in Mixed Formation. Remove casualties in such a way that front ranks always remains with Crossbows</characteristic>
      </characteristics>
    </profile>
    <profile name="Pike (Pirazzo&apos;s Legion)" typeId="a378-c633-912d-11ce" typeName="Weapon" hidden="false" id="c8c7-61c2-1fcd-3e31">
      <characteristics>
        <characteristic name="R" typeId="2360-c777-5e07-ed58">Combat</characteristic>
        <characteristic name="S" typeId="ac19-f99c-72e9-a1a7">F</characteristic>
        <characteristic name="AP" typeId="9429-ffe7-2ce5-e9a5">-1</characteristic>
        <characteristic name="Special Rules" typeId="5f83-3633-336b-93b4">Fights in Four Ranks, Strike First*</characteristic>
        <characteristic name="Notes" typeId="772a-a7ff-f6b3-df71">Pikes (Pirazzo&apos;s Legion) fight in four ranks; require two hands. Always strikes first in the initial round of close combat, even striking before enemies that have charged. Note that enemies that are entitled to Strike First because of a special ability or magic, will strike before pike-armed models.
Models armed with pikes recieve a +1 Strength bonus in the Close Combar phase on turn they are charged by cavalry units, chariots or monsters. Note that this bonus only applies to attacks directed against the above charging units, not against other units.
All these special rules cannot be used against enemy fighting the Pikemen&apos;s flank or rear.</characteristic>
      </characteristics>
    </profile>
    <profile name="Fernando Pirazzo" typeId="b070-143a-73f-2772" typeName="Model" hidden="false" id="daf4-7b1a-8058-4a51" page="Regiments of Renown, Warhammer Chronicles 2004, p. 62 (Adapted for Warhammer: The Old World - Tears of Bilbali Edition). By Autrigon Tales.">
      <characteristics>
        <characteristic name="M" typeId="cd3b-a5a4-e185-5a9d">4</characteristic>
        <characteristic name="WS" typeId="b007-7d58-4f14-1e01">5</characteristic>
        <characteristic name="BS" typeId="59f9-ccf5-1155-fb05">5</characteristic>
        <characteristic name="S" typeId="5b6b-1427-2a45-dd0c">4</characteristic>
        <characteristic name="T" typeId="ab43-8b61-83e7-d090">4</characteristic>
        <characteristic name="W" typeId="83ed-7b82-bf1f-e558">2</characteristic>
        <characteristic name="I" typeId="73b1-abe5-72f8-41e2">5</characteristic>
        <characteristic name="A" typeId="dddc-9fbd-b0fd-a480">3</characteristic>
        <characteristic name="Ld" typeId="c435-6b14-f77e-3c72">8</characteristic>
      </characteristics>
      <alias>Fernando Pirazzo</alias>
    </profile>
    <profile name="Mixed Formation" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="e6c3-a289-a470-44af">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">Casualties are always removed from the rear so front rank always remains Pirazzo&apos;s Crossbowmen.</characteristic>
      </characteristics>
    </profile>
    <profile name="Pikes" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="2e45-16fb-4849-4905">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">Pikes fight in four ranks; require two hands. Always strikes first in the initial round of close combat, even striking before enemies that have charged. Note that enemies that are entitled to strike first because of a special ability or magic, will strike before pike-armed models.
Models armed with pikes recieve a +1 Strength bonus in the Close Combar phase on turn they are charged by cavalry units, chariots or monsters. Note that this bonus only applies to attacks directed against the above charging units, not against other units.
All these special rules cannot be used against enemy fighting the Pikemen&apos;s flank or rear.</characteristic>
      </characteristics>
    </profile>
