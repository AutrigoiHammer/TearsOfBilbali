      </characteristics>
    </profile>
    <profile name="The Mace of Might" typeId="e4d1-790a-ab75-2b57" typeName="Magic Weapons" hidden="false" id="dbec-c63e-1789-18dc">
      <characteristics>
        <characteristic name="R" typeId="51c8-c0d6-94db-264c">Combat</characteristic>
        <characteristic name="S" typeId="4f75-25c9-31bd-7074">F</characteristic>
        <characteristic name="AP" typeId="15e2-fff4-477f-ea26">-</characteristic>
        <characteristic name="Special Rules" typeId="57a7-47c0-8d74-d54c"/>
        <characteristic name="Note" typeId="5e5e-34db-1ee0-86">Borgio made this weapon out of a cannon ball that hit him square in the chest, yet did not kill him. From that point on it has become his good luck charm. If Borgio rolls a 6 to hit with this weapon, that hit will be at Strength 10.</characteristic>
      </characteristics>
    </profile>
    <profile name="Monstrous Mask Helm" typeId="fefe-6a57-a203-edf9" typeName="Magic Armour" hidden="false" id="eafe-e594-2ab2-fb8d">
      <characteristics>
        <characteristic name="Description" typeId="d6b2-9b2a-d88e-eec9">This Helm causes fear.</characteristic>
      </characteristics>
    </profile>
    <profile name="Armour of Brazen Bronze" typeId="fefe-6a57-a203-edf9" typeName="Magic Armour" hidden="false" id="a0ca-2379-269e-4733">
      <characteristics>
        <characteristic name="Description" typeId="d6b2-9b2a-d88e-eec9">This counts as a suit of heavy armour that also conveys a Ward save of 5+.</characteristic>
      </characteristics>
    </profile>
    <profile name="Beloved General" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="5e80-5e11-9b26-718a">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">Borgio the Besieger was beloved by his men, and the people of Miragliano. To represent this, any friendly unit within 18&quot; may test on Borgio&apos;s Leadership. This rule replaces the normal rules for Generals found in the Warhammer rulebook</characteristic>
      </characteristics>
    </profile>
    <profile name="Difficult to Slay" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="8622-c224-1a7a-6cae">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">Borgio the Besieger has an almost unnatural ability to withstand pain and injury. If he is reduced to zero wounds, then do not remove the model, but lay it on its side and leave it in place. At the end of the phase, roll a D6. On a 1-3, he is removed as a casualty as normal. On a roll of 4 or more, he stands back up again with a single Wound remaining.</characteristic>
      </characteristics>
    </profile>
    <profile name="Ritcher Kreugar" typeId="b070-143a-73f-2772" typeName="Model" hidden="false" id="0999-3bf8-58a4-65f7" page="Warhammer Fantasy Battles 6th Edition Characters/Special Rules">
      <characteristics>
        <characteristic name="M" typeId="cd3b-a5a4-e185-5a9d">4</characteristic>
        <characteristic name="WS" typeId="b007-7d58-4f14-1e01">5</characteristic>
        <characteristic name="BS" typeId="59f9-ccf5-1155-fb05">3</characteristic>
        <characteristic name="S" typeId="5b6b-1427-2a45-dd0c">4</characteristic>
        <characteristic name="T" typeId="ab43-8b61-83e7-d090">4</characteristic>
        <characteristic name="W" typeId="83ed-7b82-bf1f-e558">2</characteristic>
        <characteristic name="I" typeId="73b1-abe5-72f8-41e2">4</characteristic>
        <characteristic name="A" typeId="dddc-9fbd-b0fd-a480">3</characteristic>
        <characteristic name="Ld" typeId="c435-6b14-f77e-3c72">9</characteristic>
      </characteristics>
    </profile>
    <profile name="Cursed Company Skeletons" typeId="b070-143a-73f-2772" typeName="Model" hidden="false" id="9218-42d0-d832-58f9" page="Warhammer Fantasy Battles 6th Edition Characters/Special Rules">
      <characteristics>
        <characteristic name="M" typeId="cd3b-a5a4-e185-5a9d">4</characteristic>
        <characteristic name="WS" typeId="b007-7d58-4f14-1e01">2</characteristic>
        <characteristic name="BS" typeId="59f9-ccf5-1155-fb05">2</characteristic>
        <characteristic name="S" typeId="5b6b-1427-2a45-dd0c">3</characteristic>
        <characteristic name="T" typeId="ab43-8b61-83e7-d090">3</characteristic>
        <characteristic name="W" typeId="83ed-7b82-bf1f-e558">1</characteristic>
        <characteristic name="I" typeId="73b1-abe5-72f8-41e2">2</characteristic>
        <characteristic name="A" typeId="dddc-9fbd-b0fd-a480">1</characteristic>
        <characteristic name="Ld" typeId="c435-6b14-f77e-3c72">3</characteristic>
      </characteristics>
    </profile>
    <profile name="Blight" typeId="e4d1-790a-ab75-2b57" typeName="Magic Weapons" hidden="false" id="e396-1ca7-dad5-47ae">
      <characteristics>
        <characteristic name="R" typeId="51c8-c0d6-94db-264c">Combat</characteristic>
        <characteristic name="S" typeId="4f75-25c9-31bd-7074">F+1</characteristic>
        <characteristic name="AP" typeId="15e2-fff4-477f-ea26"/>
        <characteristic name="Special Rules" typeId="57a7-47c0-8d74-d54c">Killing Blow</characteristic>
        <characteristic name="Note" typeId="5e5e-34db-1ee0-86">Blight is a darkly powerful blade, centuries old and suffused with unholy magic. Blight confers +1 Strength to all close combat attacks made by Ritcher. In addition, the weapon has the Killing Blow special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Dark Gem of the Cursed" typeId="5c1d-13f3-7dd6-e817" typeName="Talismans" hidden="false" id="3f9a-bea7-4806-31a8">
      <characteristics>
        <characteristic name="Description" typeId="3fa5-c856-b00a-c9f4">The Dark Gem of the Cursed glows a blood-red shade that intensifies when a blow is directed towards Richter, protection him from hard. It confers the bearer a 4+ Ward Save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Banner of Malediction" typeId="e3be-1b80-f570-96a1" typeName="Magic Standards" hidden="false" id="fbb9-0009-356a-89b0">
      <characteristics>
        <characteristic name="Description" typeId="a34c-cc25-6cb9-95e1">The sinister banner of the Cursed Company has been carried for centuries by various enslaved warriors of Richter. It is a dark parody of his original, disgraced mercenary company banner. The Cursed Company suffers one less wound than they normally would when defeated in combat. As an example, if the Cursed Company loses a combat by 3, they should lose three extra models, but because of the Banner of Malediction, they only lose two models.</characteristic>
      </characteristics>
    </profile>
    <profile name="Join us in damnation" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="6a93-4d8a-5b3b-e657" page="https://wfb6thcharacters.blogspot.com/p/blog-page_85.html">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">As part of Kreugar’s curse, any foe slain by him or his company are withered by dark magic, their flesh aging as if decades had passed in the blink of an eye. The lifeless victims instantly crumble into evil cackling laughter, rising to accompany him in his eternal curse.


If any model within the Cursed Company (including Kreugar himself) slays a model with only 1 wound on its starting profile, then one skeleton is created in its place. Models created in this way are added to the Cursed Company, and are armed in the same manner as the Company. The Victory points value of the unit is unaffected. This rule counts only for models that are killed in close combat, and not for models killed in other way (for example, running down fleeing troops).</characteristic>
      </characteristics>
      <comment>https://wfb6thcharacters.blogspot.com/p/blog-page_85.html</comment>
    </profile>
    <profile name="Independent" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="2776-82d3-bfb0-d834">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">This unit will never use the Leadership of the General, in if it is better than its own. Additionally, it cannot be joined by any characters.</characteristic>
      </characteristics>
    </profile>
    <profile name="Leader" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="54c0-38f5-37b2-aa28">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">If the Champion is slain, the unit will quickly begin to crumble to dust. At the end of the phase when Richter is killed, and at the beggining of each of their turns thereafter, it must take a Leadership Test. If it is failed, the unit suffers a number of wounds equal to the number they failed the Leadership Test by. No saves of any kind are allowed against these wounds.</characteristic>
      </characteristics>
    </profile>
    <profile name="March with Richter" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="3cfc-bb57-6c2b-7d95">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">The Cursed Company can march as long as Richter is still alive. If Richter dies, the Cursed Company cannot make march moves.</characteristic>
      </characteristics>
    </profile>
    <profile name="Deathfang" typeId="b070-143a-73f-2772" typeName="Model" hidden="false" id="11d8-193f-5bea-82cf" page="Regiments of Renown, WHFB 6th Edition (Adapted for ToW:ToB)">
      <characteristics>
        <characteristic name="M" typeId="cd3b-a5a4-e185-5a9d">6</characteristic>
        <characteristic name="WS" typeId="b007-7d58-4f14-1e01">6</characteristic>
        <characteristic name="BS" typeId="59f9-ccf5-1155-fb05">0</characteristic>
        <characteristic name="S" typeId="5b6b-1427-2a45-dd0c">6</characteristic>
        <characteristic name="T" typeId="ab43-8b61-83e7-d090">(+2)</characteristic>
        <characteristic name="W" typeId="83ed-7b82-bf1f-e558">(+5)</characteristic>
        <characteristic name="I" typeId="73b1-abe5-72f8-41e2">3</characteristic>
        <characteristic name="A" typeId="dddc-9fbd-b0fd-a480">5</characteristic>
        <characteristic name="Ld" typeId="c435-6b14-f77e-3c72">-</characteristic>
      </characteristics>
    </profile>
    <profile name="Asarnil, The Dragonlord" typeId="b070-143a-73f-2772" typeName="Model" hidden="false" id="2ebb-3014-2981-e045" page="Regiments of Renown, WHFB 6th Edition (Adapted for ToW:ToB)">
      <characteristics>
        <characteristic name="M" typeId="cd3b-a5a4-e185-5a9d">-</characteristic>
        <characteristic name="WS" typeId="b007-7d58-4f14-1e01">7</characteristic>
        <characteristic name="BS" typeId="59f9-ccf5-1155-fb05">4</characteristic>
        <characteristic name="S" typeId="5b6b-1427-2a45-dd0c">4</characteristic>
        <characteristic name="T" typeId="ab43-8b61-83e7-d090">3</characteristic>
        <characteristic name="W" typeId="83ed-7b82-bf1f-e558">2</characteristic>
        <characteristic name="I" typeId="73b1-abe5-72f8-41e2">7</characteristic>
        <characteristic name="A" typeId="dddc-9fbd-b0fd-a480">4</characteristic>
        <characteristic name="Ld" typeId="c435-6b14-f77e-3c72">9</characteristic>
      </characteristics>
    </profile>
    <profile name="Amulet of Dragonheart" typeId="d29c-a3fb-dcdf-29d6" typeName="Enchanted Items" hidden="false" id="5748-7194-a891-e550" page="https://imgur.com/AwFvaWn">
      <characteristics>
        <characteristic name="Description" typeId="cea7-7573-475d-cc1d">This amulet was one of the potent artefacts made by Caledor the Dragontamer for the Elven Dragon Princes. It is said that the gleaming gem hanging around Asarnil&apos;s neck is a stone found at the heart of a mountain, blessed by Caledor the Dragontamer himself.

The dazzling light of the Amulet of Dragonheart makes the shape of Asarnil and his Dragon appear blurry and vage, as if glanced through a haze. All missile attacks against Asarnil and his Dragon suffer a -1 to hit penalty.</characteristic>
      </characteristics>
      <comment>Red_Dox: &quot;It is very unlikely he will become a official LL. What workshop mods do is a different story. Asarnil was just a &quot;Rare+Hero&quot; choice and not a leading DoW character in TT. Still, as mentioned, he can show up as a RoR for High Elves or DoW at some point. I would also not be upset if he would lead a Rogue Army with more &quot;Dragon Lords&quot; included to doomstack piss everyone off.&quot;</comment>
    </profile>
    <profile name="Dragon fire" hidden="false" id="fbc5-7c01-9014-f854" typeId="a378-c633-912d-11ce" typeName="Weapon" page="174" publicationId="8b8d-8fc4-559e-87b1">
      <characteristics>
        <characteristic name="R" typeId="2360-c777-5e07-ed58">N/A</characteristic>
        <characteristic name="S" typeId="ac19-f99c-72e9-a1a7">4</characteristic>
        <characteristic name="AP" typeId="9429-ffe7-2ce5-e9a5">-1</characteristic>
        <characteristic name="Special Rules" typeId="5f83-3633-336b-93b4">Breath Weapon, Flaming Attacks</characteristic>
        <characteristic name="Notes" typeId="772a-a7ff-f6b3-df71">-</characteristic>
      </characteristics>
    </profile>
    <profile name="Dragon Tamer" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="6a36-a6a9-9aad-92b3" page="https://imgur.com/JZ5zZ4Y">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">Enemy Dragons must take a Leadership test at the start of each Combat phase in order to attack Asarnil, the Dragonlord. If the test is failed, the Dragon may not make any attacks against Asarnil that phase. This does not affect Stomp Attacks.</characteristic>
      </characteristics>
    </profile>
    <profile name="Rakarth&apos;s Whip of Agony" typeId="e4d1-790a-ab75-2b57" typeName="Magic Weapons" hidden="false" id="3695-9573-5b6c-7e19" page="https://www.reddit.com/media?url=https%3A%2F%2Fpreview.redd.it%2Fbeastlord-rakarth-v0-qr0wach6on1e1.jpg%3Fwidth%3D996%26format%3Dpjpg%26auto%3Dwebp%26s%3Dc78cd47ee6dfa9adf155a889704237d9da039807">
      <characteristics>
        <characteristic name="R" typeId="51c8-c0d6-94db-264c">Combat</characteristic>
        <characteristic name="S" typeId="4f75-25c9-31bd-7074">F</characteristic>
        <characteristic name="AP" typeId="15e2-fff4-477f-ea26"/>
        <characteristic name="Special Rules" typeId="57a7-47c0-8d74-d54c"/>
        <characteristic name="Note" typeId="5e5e-34db-1ee0-86">Rakarth may use his Whip of Agony to make one attack at the start of each hand-to-hand combat phase. This attack is in addition to his normal attacks by either, before any other attacks by either side are resolved. Roll to hit as normal. If the attack hits, then the victim does not take any damage, but must pass a Leadership test in order to attack in that hand-to-hand combat phase.

If the victim fails the Leadership Test, they are overcome with pain and may not attack that turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="Rakarth&apos;s Enchanted Shield" typeId="fefe-6a57-a203-edf9" typeName="Magic Armour" hidden="false" id="eaf2-2c17-1f57-a735">
      <characteristics>
        <characteristic name="Description" typeId="d6b2-9b2a-d88e-eec9">It provides an additional +1 armour save to an standard shield. It may never surpass the 3+ armour save limitation for Monsters.</characteristic>
      </characteristics>
    </profile>
    <profile name="Rakarth&apos;s Armour of Fortune" typeId="fefe-6a57-a203-edf9" typeName="Magic Armour" hidden="false" id="c717-51f5-be17-3566">
      <characteristics>
        <characteristic name="Description" typeId="d6b2-9b2a-d88e-eec9">It counts as heavy armour. Rakarth rolls to save as normal. If he fails his normal armour saving throw, he can immediatelly roll again, this time saving on a roll of 5+ or more, but ignoring saving roll modifiers previously applied (this is, always saving at 5+, except when attacked by weapons, spells or missiles negating armour saves)</characteristic>
      </characteristics>
    </profile>
    <profile name="The Beastlord" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="1071-7328-572b-acc5" page="(Modified to fulfill the meta) https://www.reddit.com/media?url=https%3A%2F%2Fpreview.redd.it%2Fbeastlord-rakarth-v0-qr0wach6on1e1.jpg%3Fwidth%3D996%26format%3Dpjpg%26auto%3Dwebp%26s%3Dc78cd47ee6dfa9adf155a889704237d9da039807">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">Rakarth is an expert at controlling wild monsters and making them do his bidding. If he wins or draws a round of hand-to-hand combat, then any monster he was fighting must take a Leadership test in the following Combat round. If this test is failed, the Monster cannot attack for that Combat round.</characteristic>
      </characteristics>
    </profile>
    <profile name="Rakarth, The Beastlord" typeId="b070-143a-73f-2772" typeName="Model" hidden="false" id="f71c-17f9-ecba-5476" page="WFB 4th Edition (Adapted for ToW:ToB), 0531 Beastlord Rakarth, Dark Elf Dragonrider. [1] &quot;White Dwarf 189&quot;, (Sep. 1995), pgs: 80-81">
