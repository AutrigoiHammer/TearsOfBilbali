    <profile name="The Besieger&apos;s Pavise" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="582a-ba75-f257-d391">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">This pavise is a large shield which each crossbowman props in front of him. Such pavises save on a roll 3+ against shooting attacks if these are happening through the front of the unit.</characteristic>
      </characteristics>
    </profile>
    <profile name="Drong" typeId="b070-143a-73f-2772" typeName="Model" hidden="false" id="cfec-f037-602f-487f">
