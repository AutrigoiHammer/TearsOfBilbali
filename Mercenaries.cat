    <profile name="Mercenary Horse" typeId="b070-143a-73f-2772" typeName="Model" hidden="false" id="7865-c659-6c3b-7988" page="Army Book of Dogs of War in Warhammer Fantasy 5th Edition">
      <characteristics>
