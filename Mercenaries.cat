    <profile name="Borgio&apos;s Warhorse" typeId="b070-143a-73f-2772" typeName="Model" hidden="false" id="4b82-45c2-43d3-5985" page="Army Book of Dogs of War in Warhammer Fantasy 5th Edition">
      <characteristics>
