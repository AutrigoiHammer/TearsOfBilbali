    <profile name="Hobgoblin Wolfboy" typeId="b070-143a-73f-2772" typeName="Model" hidden="false" id="6b5e-d65a-53e5-a6bb" page="Dogs of War Army List, Warhammer Fantasy 5th Edition, Adapted for ToW">
