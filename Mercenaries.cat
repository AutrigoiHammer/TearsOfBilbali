    <profile name="Noxious breath" typeId="a378-c633-912d-11ce" typeName="Weapon" hidden="false" id="8c8b-d7c0-b386-f909">
      <characteristics>
        <characteristic name="R" id="9b15-aa15-f9d1-1384" hidden="false" typeId="2360-c777-5e07-ed58">N/A</characteristic>
        <characteristic name="S" id="cb01-d751-7e26-8947" hidden="false" typeId="ac19-f99c-72e9-a1a7">4</characteristic>
        <characteristic name="AP" id="aec2-cbed-5f30-3842" hidden="false" typeId="9429-ffe7-2ce5-e9a5">N/A</characteristic>
        <characteristic name="Special Rules" id="b7d4-6982-0f76-b056" hidden="false" typeId="5f83-3633-336b-93b4">Breath Weapon</characteristic>
        <characteristic name="Notes" id="7b1c-1a95-cf59-8dc5" hidden="false" typeId="772a-a7ff-f6b3-df71">Until your next Start of Turn sub-phase, every model in a unit that suffers one or more unsaved wounds from this weapon suffers a -1 modifier to its Weapon Skill characteristic (to a minimum of 1). No armour save is permitted against wounds caused by this weapon (Ward and Regeneration saves can be attempted as normal).</characteristic>
      </characteristics>
    </profile>
    <profile name="Birdmen" typeId="b070-143a-73f-2772" typeName="Model" hidden="false" id="b3fc-db99-178b-09d0" page="Dogs of War Army List, Warhammer Fantasy 5th Edition">
