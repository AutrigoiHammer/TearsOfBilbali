    <profile name="The Red Scimitar" typeId="e4d1-790a-ab75-2b57" typeName="Magic Weapons" hidden="false" id="085b-cc4f-6c08-2d10">
      <characteristics>
        <characteristic name="R" typeId="51c8-c0d6-94db-264c">Combat</characteristic>
        <characteristic name="S" typeId="4f75-25c9-31bd-7074">F</characteristic>
        <characteristic name="AP" typeId="15e2-fff4-477f-ea26">-3</characteristic>
        <characteristic name="Special Rules" typeId="57a7-47c0-8d74-d54c">Multiple Wounds (D3)</characteristic>
        <characteristic name="Note" typeId="5e5e-34db-1ee0-86"/>
      </characteristics>
    </profile>
    <profile name="Daemon Head Helmet" typeId="fefe-6a57-a203-edf9" typeName="Magic Armour" hidden="false" id="b298-5cac-c01b-072a">
      <characteristics>
        <characteristic name="Description" typeId="d6b2-9b2a-d88e-eec9">After Ghazak Khan receives his first wound in combat, Ghazak Khan gains a Ward Save (4+) for the remainder of the battle.</characteristic>
      </characteristics>
    </profile>
    <profile name="The Mighty Khan" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="6901-1582-6337-60bc">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">Ghazak Khan has a +4 modifier on his Strength characteristic whenever it fights the model that caused his first wound.</characteristic>
      </characteristics>
    </profile>
    <profile name="Ghazak Khan" typeId="b070-143a-73f-2772" typeName="Model" hidden="false" id="16bc-bdf7-46cc-2ab3" page="https://zharr-naggrund.poderna.com/wp-content/uploads/2019/01/white-dwarf-47.pdf">
