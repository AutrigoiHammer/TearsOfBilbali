      </characteristics>
    </profile>
    <profile name="The Mace of Might" typeId="e4d1-790a-ab75-2b57" typeName="Magic Weapons" hidden="false" id="dbec-c63e-1789-18dc">
      <characteristics>
        <characteristic name="R" typeId="51c8-c0d6-94db-264c">Combat</characteristic>
        <characteristic name="S" typeId="4f75-25c9-31bd-7074">F</characteristic>
        <characteristic name="AP" typeId="15e2-fff4-477f-ea26">-</characteristic>
        <characteristic name="Special Rules" typeId="57a7-47c0-8d74-d54c"/>
        <characteristic name="Note" typeId="5e5e-34db-1ee0-86">Borgio made this weapon out of a cannon ball that hit him square in the chest, yet did not kill him. From that point on it has become his good luck charm. If Borgio rolls a 6 to hit with this weapon, that hit will be at Strength 10.</characteristic>
      </characteristics>
    </profile>
    <profile name="Monstrous Mask Helm" typeId="fefe-6a57-a203-edf9" typeName="Magic Armour" hidden="false" id="eafe-e594-2ab2-fb8d">
      <characteristics>
        <characteristic name="Description" typeId="d6b2-9b2a-d88e-eec9">This Helm causes fear.</characteristic>
      </characteristics>
    </profile>
    <profile name="Armour of Brazen Bronze" typeId="fefe-6a57-a203-edf9" typeName="Magic Armour" hidden="false" id="a0ca-2379-269e-4733">
      <characteristics>
        <characteristic name="Description" typeId="d6b2-9b2a-d88e-eec9">This counts as a suit of heavy armour that also conveys a Ward save of 5+.</characteristic>
      </characteristics>
    </profile>
    <profile name="Beloved General" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="5e80-5e11-9b26-718a">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">Borgio the Besieger was beloved by his men, and the people of Miragliano. To represent this, any friendly unit within 18&quot; may test on Borgio&apos;s Leadership. This rule replaces the normal rules for Generals found in the Warhammer rulebook</characteristic>
      </characteristics>
    </profile>
    <profile name="Difficult to Slay" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="8622-c224-1a7a-6cae">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">Borgio the Besieger has an almost unnatural ability to withstand pain and injury. If he is reduced to zero wounds, then do not remove the model, but lay it on its side and leave it in place. At the end of the phase, roll a D6. On a 1-3, he is removed as a casualty as normal. On a roll of 4 or more, he stands back up again with a single Wound remaining.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
