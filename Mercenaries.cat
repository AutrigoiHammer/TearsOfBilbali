    <profile name="Grimacing Death Mask" typeId="d29c-a3fb-dcdf-29d6" typeName="Enchanted Items" hidden="false" id="7441-662a-5748-0216">
      <characteristics>
        <characteristic name="Description" typeId="cea7-7573-475d-cc1d">All enemy models in base contact with Vespero lose one attack in the first round of Close Combat. Yes, models with one attack would have zero attacks in this regard. This has no effect on models with Immunity (Psychology) special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Roderigo Delmonte" typeId="b070-143a-73f-2772" typeName="Model" hidden="false" id="a626-ce53-15d9-4f4b" page="Regiments of Renown, Warhammer Chronicles 2004, p. 62 (Adapted for Warhammer: The Old World - Tears of Bilbali Edition). By Autrigon Tales.">
