    <profile name="Infested" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="2368-87b7-7d34-5a">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">When this model loses its last Wound, every unit in base contact with it (friend or foe) suffers D6 Strength 2 hits, each with an AP of -1.</characteristic>
      </characteristics>
    </profile>
    <profile name="Range: Self" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="97ea-8077-af28-502">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">Character Mount: A Coven Throne may only be included in your army as a character’s mount. Its points are added to that of its rider.</characteristic>
      </characteristics>
    </profile>
    <profile name="Spectral Scythe" typeId="a378-c633-912d-11ce" typeName="Weapon" hidden="false" id="af7f-d19a-b801-c2f7">
