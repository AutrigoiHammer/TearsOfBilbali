        <characteristic name="R" typeId="2360-c777-5e07-ed58">Combat</characteristic>
        <characteristic name="S" typeId="ac19-f99c-72e9-a1a7">S</characteristic>
        <characteristic name="AP" typeId="9429-ffe7-2ce5-e9a5">-1</characteristic>
        <characteristic name="Special Rules" typeId="5f83-3633-336b-93b4">Magical Attacks, Armour Bane (1)</characteristic>
        <characteristic name="Notes" typeId="772a-a7ff-f6b3-df71"/>
      </characteristics>
    </profile>
    <profile name="Sword of the Thirteen Seas" typeId="e4d1-790a-ab75-2b57" typeName="Magic Weapons" hidden="false" id="5a8c-fb7a-0969-110e">
      <characteristics>
        <characteristic name="R" typeId="51c8-c0d6-94db-264c">Combat</characteristic>
        <characteristic name="S" typeId="4f75-25c9-31bd-7074">S+1</characteristic>
        <characteristic name="AP" typeId="15e2-fff4-477f-ea26">*</characteristic>
        <characteristic name="Special Rules" typeId="57a7-47c0-8d74-d54c">Magical Attacks</characteristic>
        <characteristic name="Note" typeId="5e5e-34db-1ee0-86">Wounds caused by the Sword of the Thirteen Seas prevent the enemy&apos;s Armor Saving Rolls and Regeneration; Ward Saves can be rolled normally.</characteristic>
      </characteristics>
    </profile>
    <profile name="Kraken Bane" typeId="e4d1-790a-ab75-2b57" typeName="Magic Weapons" hidden="false" id="5768-8621-45ed-0a64">
      <characteristics>
        <characteristic name="R" typeId="51c8-c0d6-94db-264c">Combat</characteristic>
        <characteristic name="S" typeId="4f75-25c9-31bd-7074">S+1</characteristic>
        <characteristic name="AP" typeId="15e2-fff4-477f-ea26">-1</characteristic>
        <characteristic name="Special Rules" typeId="57a7-47c0-8d74-d54c">Magical Attacks, Multiple Wounds (2)</characteristic>
        <characteristic name="Note" typeId="5e5e-34db-1ee0-86">The bearer can re-roll wound rolls against behemoths, monsters or monstrous creatures.</characteristic>
      </characteristics>
    </profile>
    <profile name="The Hook of Levi “the Lucky One”" typeId="e4d1-790a-ab75-2b57" typeName="Magic Weapons" hidden="false" id="e0ef-5117-a4ae-912d">
      <characteristics>
        <characteristic name="R" typeId="51c8-c0d6-94db-264c">Combat</characteristic>
        <characteristic name="S" typeId="4f75-25c9-31bd-7074">S</characteristic>
        <characteristic name="AP" typeId="15e2-fff4-477f-ea26">-1</characteristic>
        <characteristic name="Special Rules" typeId="57a7-47c0-8d74-d54c">Magical Attacks, Extra Attacks (1)</characteristic>
        <characteristic name="Note" typeId="5e5e-34db-1ee0-86">The enemy must re-roll successful armor saving throws against attacks from this weapon.</characteristic>
      </characteristics>
    </profile>
    <profile name="The Cursed Rifle" typeId="e4d1-790a-ab75-2b57" typeName="Magic Weapons" hidden="false" id="526a-e563-2920-c1f5" noindex="false">
      <characteristics>
        <characteristic name="R" typeId="51c8-c0d6-94db-264c">30&quot;</characteristic>
        <characteristic name="S" typeId="4f75-25c9-31bd-7074">5</characteristic>
        <characteristic name="AP" typeId="15e2-fff4-477f-ea26">-1</characteristic>
        <characteristic name="Special Rules" typeId="57a7-47c0-8d74-d54c">Armor Bane (2), Magical Attacks, Multiple Shots (D3+1), Ponderous</characteristic>
        <characteristic name="Note" typeId="5e5e-34db-1ee0-86"/>
      </characteristics>
      <alias>This ramshackle-looking musket fires with tremendous power.</alias>
    </profile>
    <profile name="Breastplate of the Seas" typeId="fefe-6a57-a203-edf9" typeName="Magic Armour" hidden="false" id="53c8-2506-a4af-f6d4">
      <characteristics>
        <characteristic name="Description" typeId="d6b2-9b2a-d88e-eec9">The Breastplate of the Seas is Full Plate Armor. 


For each successful armor save its wearer makes, the inflicting unit suffers a Strength 3 hit that prevents Armor Save, 


Regeneration, and Ward Save can be used normally.</characteristic>
      </characteristics>
    </profile>
    <profile name="Eel Skin" typeId="fefe-6a57-a203-edf9" typeName="Magic Armour" hidden="false" id="33f6-3564-d51c-5c54">
      <characteristics>
        <characteristic name="Description" typeId="d6b2-9b2a-d88e-eec9">The Eel Skin is a Light Armor that provides a Special Saving Roll of 6+ and can re-roll failed armor or ward saves. 


Allows its wielder to cast spells without penalty. Note: With Renegade Legacy pack the cost is 25 points</characteristic>
      </characteristics>
    </profile>
    <profile name="Driftwood Crown" typeId="5c1d-13f3-7dd6-e817" typeName="Talismans" hidden="false" id="48b9-ac7f-6e76-04a5">
      <characteristics>
        <characteristic name="Description" typeId="3fa5-c856-b00a-c9f4">At the beginning of each turn the bearer can use the &apos;Invocation of Nehek&apos; ability, as if he were a level 1 Wizard, on an allied infantry unit within 6&quot; of Zombie Pirates or Zombie Pirate Gunners, being able to exceed the initial size of miniatures.</characteristic>
      </characteristics>
    </profile>
    <profile name="Coin of Eight" typeId="5c1d-13f3-7dd6-e817" typeName="Talismans" hidden="false" id="4eb0-b82c-e26d-ed9a">
      <characteristics>
        <characteristic name="Description" typeId="3fa5-c856-b00a-c9f4">Roll D3+1 at the beginning of the game, the bearer can do that number of repetitions throughout the game for any dice they wish in their rolls</characteristic>
      </characteristics>
    </profile>
    <profile name="Captain&apos;s Hat" typeId="5c1d-13f3-7dd6-e817" typeName="Talismans" hidden="false" id="a1cf-fd9f-6f6b-4909">
      <characteristics>
        <characteristic name="Description" typeId="3fa5-c856-b00a-c9f4">The character has a Ward Save of 6+. 


In addition, they extend the range of their ‘Command Orders’ special rule by 8&quot;, or gain that rule if they did not already have it.</characteristic>
      </characteristics>
    </profile>
    <profile name="Boarding Flag" typeId="e3be-1b80-f570-96a1" typeName="Magic Standards" hidden="false" id="4bb8-61f8-ba93-a6c4">
      <characteristics>
        <characteristic name="Description" typeId="a34c-cc25-6cb9-95e1">The unit gains the Hate (all Enemies) and Frenzy special rule and cannot lose this special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Volley Banner" typeId="e3be-1b80-f570-96a1" typeName="Magic Standards" hidden="false" id="72e9-6622-f16d-55d7">
      <characteristics>
        <characteristic name="Description" typeId="a34c-cc25-6cb9-95e1">The unit can re-roll hit rolls of 1 for its ranged attacks.</characteristic>
      </characteristics>
    </profile>
    <profile name="Banner of the Depths" typeId="e3be-1b80-f570-96a1" typeName="Magic Standards" hidden="false" id="6897-a9d3-813e-0568">
      <characteristics>
        <characteristic name="Description" typeId="a34c-cc25-6cb9-95e1">Depth Guard units only. At the end of a combat round in which this unit has eliminated an enemy model, recover a model that was previously eliminated from this unit. It is not possible to recover characters that have been added in this way.</characteristic>
      </characteristics>
    </profile>
    <profile name="Lost Skull" typeId="e3be-1b80-f570-96a1" typeName="Magic Standards" hidden="false" id="13f6-f9fe-2405-7c65">
      <characteristics>
        <characteristic name="Description" typeId="a34c-cc25-6cb9-95e1">Only Zombie Pirate or Zombie Pirate Gunner units. 


Each time a friendly or enemy sorcerer successfully casts a spell within 18&quot; of the unit, roll 1d6, on a 4+ add an additional model to the unit, potentially exceeding the initial size of models. 


This ability can&apos;t recover miniatures from the Command Group.</characteristic>
      </characteristics>
    </profile>
    <profile name="Crazy Mullet&apos;s Spyglass" typeId="d29c-a3fb-dcdf-29d6" typeName="Enchanted Items" hidden="false" id="f027-45a7-877d-31a1">
      <characteristics>
        <characteristic name="Description" typeId="cea7-7573-475d-cc1d">At the start of your Shooting Phase, if this character is not engaged in close combate, a unit within this character&apos;s command range may re-roll Wound rolls of 1 with their projectile weapons against a unit in line of sight of the bearer until the begining of your next turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="Orb of the Depths" typeId="d29c-a3fb-dcdf-29d6" typeName="Enchanted Items" hidden="false" id="3868-58d4-f14a-2d8c">
      <characteristics>
        <characteristic name="Description" typeId="cea7-7573-475d-cc1d">Single use. Can be used at the end of any of your Movement phases: designate a point within 8” of the caster. 


At that point a unit of Zombie Pirates appears consisting of 2D3+8 members equipped with Hand Weapon. 


They cannot appear locked in melee combat and the unit summoned by the Orb does not award victory points.</characteristic>
      </characteristics>
    </profile>
    <profile name="Vortex Pearl" typeId="65d6-7512-2a53-bd6c" typeName="Arcane Items" hidden="false" id="b732-ed7e-50cb-d994">
      <characteristics>
        <characteristic name="Description" typeId="fdd8-b367-1d68-c9cd">The sorcerer will know an additional spell, which will always be an Signature spell from the Lore of the Deep (he may also change another spell for a Signature as normal). 


Additionally, the wearer gains a +1 bonus to their spellcasting rolls.</characteristic>
      </characteristics>
    </profile>
    <profile name="The Cursed Medallion" typeId="d29c-a3fb-dcdf-29d6" typeName="Enchanted Items" hidden="false" id="d691-dc6b-9553-dc5e">
      <characteristics>
        <characteristic name="Description" typeId="cea7-7573-475d-cc1d">The wearer improves their Regeneration special rule by +1 but the bearer can&apos;t roll any armor save or ward save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Skeleton Monkey" typeId="d29c-a3fb-dcdf-29d6" typeName="Enchanted Items" hidden="false" id="d8cf-d087-1b11-3ccf">
      <characteristics>
        <characteristic name="Description" typeId="cea7-7573-475d-cc1d">The wearer has Magic Resistance (-2) special rule. However, each time the wearer suffers a wound roll 1d6, on a 5+ the Skeleton Monkey is destroyed and the wound is avoided.</characteristic>
      </characteristics>
    </profile>
    <profile name="Dream Chant Pendant" typeId="65d6-7512-2a53-bd6c" typeName="Arcane Items" hidden="false" id="ac18-9ef5-6cbc-9adb">
      <characteristics>
        <characteristic name="Description" typeId="fdd8-b367-1d68-c9cd">The sorcerer will know an additional spell, which will always be an Signature spell from the Lore of the Deep (he may also change another spell for a Signature as normal). 


Additionally, the wearer gains a +1 bonus to their spellcasting rolls.</characteristic>
      </characteristics>
    </profile>
    <profile name="Dream Chant Pendant" typeId="8232-ae14-b1f6-b4df" typeName="Spell" hidden="false" id="879d-a34c-ff1f-b0d3">
      <characteristics>
        <characteristic name="Number" typeId="8a2b-690b-e552-6aa0">-</characteristic>
        <characteristic name="Type" typeId="c2ca-5fd1-5e9d-bc90">Hex</characteristic>
        <characteristic name="Casting Value" typeId="d84d-3b8b-654a-9e1a">7+</characteristic>
        <characteristic name="Range" typeId="1043-a0ad-2909-dd28">21&quot;</characteristic>
        <characteristic name="Effect" typeId="64ba-31-acf0-5a">Until your next Start of Turn subphase, the target unit takes a -1 penalty to its WS and BS and suffers the Stupidity rule. This spell may target an enemy unit engaged in combat.</characteristic>
      </characteristics>
    </profile>
    <profile name="Familiar Zombie Parrot" typeId="65d6-7512-2a53-bd6c" typeName="Arcane Items" hidden="false" id="060e-bb47-d377-9559">
      <characteristics>
        <characteristic name="Description" typeId="fdd8-b367-1d68-c9cd">0-1 per character. Once per turn the wielder can reroll a dice from a casting or dispell roll</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
