    <profile name="Back off sir!" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="f205-02b6-69a3-baf1">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">If this model is &apos;infantry&apos; type, it is considered under heavy cover if it is within 3&quot; of a friendly unit whose troop type is &apos;war machine&apos;</characteristic>
      </characteristics>
    </profile>
    <profile name="Master gunner" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="3196-edd5-234c-e412">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">Except if the model is engaged in combat, once per turn, a friendly Vampire Coast war machine within its command range can reroll a single Artillery Dice.</characteristic>
      </characteristics>
    </profile>
    <profile name="Mourngul Hunter" typeId="b070-143a-73f-2772" typeName="Model" hidden="false" id="e4b9-5447-7680-1f3e">
