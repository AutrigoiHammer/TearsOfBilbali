    <profile name="Sacred Giraffe" hidden="false" id="8e37-ffbd-2d9a-9307" typeId="b070-143a-73f-2772" typeName="Model">
      <characteristics>
        <characteristic name="M" typeId="cd3b-a5a4-e185-5a9d">6</characteristic>
        <characteristic name="WS" typeId="b007-7d58-4f14-1e01">4</characteristic>
        <characteristic name="BS" typeId="59f9-ccf5-1155-fb05">-</characteristic>
        <characteristic name="S" typeId="5b6b-1427-2a45-dd0c">4</characteristic>
        <characteristic name="T" typeId="ab43-8b61-83e7-d090">(+2)</characteristic>
        <characteristic name="W" typeId="83ed-7b82-bf1f-e558">(+3)</characteristic>
        <characteristic name="I" typeId="73b1-abe5-72f8-41e2">2</characteristic>
        <characteristic name="A" typeId="dddc-9fbd-b0fd-a480">2</characteristic>
        <characteristic name="Ld" typeId="c435-6b14-f77e-3c72">-</characteristic>
      </characteristics>
    </profile>
    <profile name="Ancestral Faith" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="a1e7-df30-bd11-4082">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">Any friendly Savannah Elves unit within 6&quot; of one or more units with the Ancestral Faith special rule gains a 6+ Ward Save. 
This benefit is not stackable and is lost immediately if the unit moves outside this range.</characteristic>
      </characteristics>
    </profile>
    <profile name="Privemal Faith" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="655c-82aa-f00e-8600">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">This unit has a 5+ Ward save against any wounds suffered.</characteristic>
      </characteristics>
    </profile>
    <profile name="Hit &amp; Run" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="c5a0-b8aa-b7e9-d725">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">Should it win a round of combat, a unit with this special rule may choose to Fall Back in Good Order rather than making a follow up or pursuit move.</characteristic>
      </characteristics>
    </profile>
    <profile name="War Lion" typeId="b070-143a-73f-2772" typeName="Model" hidden="false" id="8e62-0f70-b1c1-30a5">
      <characteristics>
        <characteristic name="M" typeId="cd3b-a5a4-e185-5a9d">8</characteristic>
        <characteristic name="WS" typeId="b007-7d58-4f14-1e01">5</characteristic>
        <characteristic name="BS" typeId="59f9-ccf5-1155-fb05">0</characteristic>
        <characteristic name="S" typeId="5b6b-1427-2a45-dd0c">4</characteristic>
        <characteristic name="T" typeId="ab43-8b61-83e7-d090">4</characteristic>
        <characteristic name="W" typeId="83ed-7b82-bf1f-e558">1</characteristic>
        <characteristic name="I" typeId="73b1-abe5-72f8-41e2">4</characteristic>
        <characteristic name="A" typeId="dddc-9fbd-b0fd-a480">2</characteristic>
        <characteristic name="Ld" typeId="c435-6b14-f77e-3c72">7</characteristic>
      </characteristics>
    </profile>
    <profile name="Lion Cloak" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="8423-7695-bf33-ff9c" page="185" publicationId="8b8d-8fc4-559e-87b1">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">A model with this special rule improves its armour value by 1 (to a maximum of 2+) against non-magical shooting attacks.</characteristic>
      </characteristics>
    </profile>
    <profile name="Great Horns" typeId="a378-c633-912d-11ce" typeName="Weapon" hidden="false" id="e955-580e-049e-50aa">
      <characteristics>
        <characteristic name="R" typeId="2360-c777-5e07-ed58">Combat</characteristic>
        <characteristic name="S" typeId="ac19-f99c-72e9-a1a7">S</characteristic>
        <characteristic name="AP" typeId="9429-ffe7-2ce5-e9a5">-3</characteristic>
        <characteristic name="Special Rules" typeId="5f83-3633-336b-93b4">-</characteristic>
        <characteristic name="Notes" typeId="772a-a7ff-f6b3-df71"/>
      </characteristics>
    </profile>
    <profile name="Wicked Claws" typeId="a378-c633-912d-11ce" typeName="Weapon" hidden="false" id="3320-b408-49e7-80cd">
      <characteristics>
        <characteristic name="R" typeId="2360-c777-5e07-ed58">Combat</characteristic>
        <characteristic name="S" typeId="ac19-f99c-72e9-a1a7">S</characteristic>
        <characteristic name="AP" typeId="9429-ffe7-2ce5-e9a5">-2</characteristic>
        <characteristic name="Special Rules" typeId="5f83-3633-336b-93b4">-</characteristic>
        <characteristic name="Notes" typeId="772a-a7ff-f6b3-df71">-</characteristic>
      </characteristics>
    </profile>
    <profile name="Blazing Plumage" typeId="c14f-740-8107-d34b" typeName="Armour" hidden="false" id="e310-d4b8-705c-a9c2">
      <characteristics>
        <characteristic name="Description" typeId="adcd-c649-e6fc-a9f6">Blazing Plumage counts as Heavy Armour.</characteristic>
      </characteristics>
    </profile>
    <profile name="Soul of Eternity" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="7538-6700-f69f-a8c2">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">When a Flamespyre Phoenix loses its last Wound, roll a D6 before removing the model from play:
• On a roll of 1-3, the Phoenix crumbles into dust and is removed from play.
• On a roll of 4, the Phoenix (and its rider, should it have one) are briefly consumed in a ball of flames, and are immediately reborn, recovering a maximum of 1 Wound.
• On a roll of 5, the Phoenix (and its rider, should it have one) are briefly consumed in a ball of flames, and are immediately reborn, recovering a maximum of 2 Wounds.
• On a roll of 6, the Phoenix (and its rider, should it have one) are briefly consumed in a ball of flames, and are immediately reborn, recovering a maximum of 3 Wounds.
The Phoenix (and its rider, should it have one), can never recover more wounds than the last time it was reborn.</characteristic>
      </characteristics>
    </profile>
    <profile name="Purification of the Glade" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="275a-f9aa-f7e3-657c">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">This model may perform a ‘Purification of the Glade’ move for each single allied unit, which can be engaged in combat. 
To do so, this model must move (by flying) over the unit it wishes to affect during the Remaining Moves sub-phase.

Once this model’s movement is complete, allied units benefit from recovering (D3) Lost Wounds. 
Monsters only recover (1) Wound.</characteristic>
      </characteristics>
    </profile>
    <profile name="Sun-Scorched Phoenix" hidden="false" id="7548-20e5-f11e-3159" typeId="b070-143a-73f-2772" typeName="Model">
      <characteristics>
        <characteristic name="M" typeId="cd3b-a5a4-e185-5a9d">2</characteristic>
        <characteristic name="WS" typeId="b007-7d58-4f14-1e01">5</characteristic>
        <characteristic name="BS" typeId="59f9-ccf5-1155-fb05">0</characteristic>
        <characteristic name="S" typeId="5b6b-1427-2a45-dd0c">5</characteristic>
        <characteristic name="T" typeId="ab43-8b61-83e7-d090">5</characteristic>
        <characteristic name="W" typeId="83ed-7b82-bf1f-e558">5</characteristic>
        <characteristic name="I" typeId="73b1-abe5-72f8-41e2">4</characteristic>
        <characteristic name="A" typeId="dddc-9fbd-b0fd-a480">3</characteristic>
        <characteristic name="Ld" typeId="c435-6b14-f77e-3c72">7</characteristic>
      </characteristics>
    </profile>
    <profile name="Sun-Scorched Phoenix (Mount)" hidden="false" id="d389-48e1-e468-3ab3" typeId="b070-143a-73f-2772" typeName="Model">
      <characteristics>
        <characteristic name="M" typeId="cd3b-a5a4-e185-5a9d">2</characteristic>
        <characteristic name="WS" typeId="b007-7d58-4f14-1e01">5</characteristic>
        <characteristic name="BS" typeId="59f9-ccf5-1155-fb05">-</characteristic>
        <characteristic name="S" typeId="5b6b-1427-2a45-dd0c">5</characteristic>
        <characteristic name="T" typeId="ab43-8b61-83e7-d090">+2</characteristic>
        <characteristic name="W" typeId="83ed-7b82-bf1f-e558">+3</characteristic>
        <characteristic name="I" typeId="73b1-abe5-72f8-41e2">4</characteristic>
        <characteristic name="A" typeId="dddc-9fbd-b0fd-a480">3</characteristic>
        <characteristic name="Ld" typeId="c435-6b14-f77e-3c72">-</characteristic>
      </characteristics>
    </profile>
    <profile name="Simbo&apos;s Mallet" typeId="e4d1-790a-ab75-2b57" typeName="Magic Weapons" hidden="false" id="3730-c468-2e3d-e666">
      <characteristics>
        <characteristic name="R" typeId="51c8-c0d6-94db-264c">Combat</characteristic>
        <characteristic name="S" typeId="4f75-25c9-31bd-7074">S+3</characteristic>
        <characteristic name="AP" typeId="15e2-fff4-477f-ea26">-3</characteristic>
        <characteristic name="Special Rules" typeId="57a7-47c0-8d74-d54c">Requires Two Hands, Magical Attacks</characteristic>
        <characteristic name="Note" typeId="5e5e-34db-1ee0-86">No Renegeration saves are permitted against wounds caused by this weapon</characteristic>
      </characteristics>
    </profile>
    <profile name="Sword of the Twilight" typeId="e4d1-790a-ab75-2b57" typeName="Magic Weapons" hidden="false" id="3868-81e5-2b01-d86e">
      <characteristics>
        <characteristic name="R" typeId="51c8-c0d6-94db-264c">Combat</characteristic>
        <characteristic name="S" typeId="4f75-25c9-31bd-7074">S+2</characteristic>
        <characteristic name="AP" typeId="15e2-fff4-477f-ea26">-2</characteristic>
        <characteristic name="Special Rules" typeId="57a7-47c0-8d74-d54c">Magical Attacks</characteristic>
        <characteristic name="Note" typeId="5e5e-34db-1ee0-86">From the start of the wielder&apos;s third turn onwards, the wielder gains the Monster Slayer special rule (of course, if the wielder still carries this weapon).</characteristic>
      </characteristics>
    </profile>
    <profile name="Spear of Preservation" typeId="e4d1-790a-ab75-2b57" typeName="Magic Weapons" hidden="false" id="fd38-005d-a606-9ca3">
      <characteristics>
        <characteristic name="R" typeId="51c8-c0d6-94db-264c">24&quot;</characteristic>
        <characteristic name="S" typeId="4f75-25c9-31bd-7074">6</characteristic>
        <characteristic name="AP" typeId="15e2-fff4-477f-ea26">-3</characteristic>
        <characteristic name="Special Rules" typeId="57a7-47c0-8d74-d54c">Magical Attacks, Multiple Wounds (2), Through &amp; Through</characteristic>
        <characteristic name="Note" typeId="5e5e-34db-1ee0-86">The Spear of the Preservation is treated as a bolt thrower for the purposes of shooting, using the ‘Through &amp; Through’ special rule. It cannot be used to make a Stand and Shoot charge reaction.</characteristic>
      </characteristics>
    </profile>
    <profile name="Dagger of the Wardance" typeId="e4d1-790a-ab75-2b57" typeName="Magic Weapons" hidden="false" id="0328-9cb3-1c3d-a504">
      <characteristics>
        <characteristic name="R" typeId="51c8-c0d6-94db-264c">Combat</characteristic>
        <characteristic name="S" typeId="4f75-25c9-31bd-7074">S</characteristic>
        <characteristic name="AP" typeId="15e2-fff4-477f-ea26">-1</characteristic>
        <characteristic name="Special Rules" typeId="57a7-47c0-8d74-d54c">Magical Attacks</characteristic>
        <characteristic name="Note" typeId="5e5e-34db-1ee0-86">The wielder of the Dagger of the Wardance gains the Killing Blow and Strike First special rule in a turn that has been charged or the wielder has charged. He losses them whenever the prior conditions are not being covered.</characteristic>
      </characteristics>
    </profile>
    <profile name="Pelt of the Firstborn Felid" typeId="fefe-6a57-a203-edf9" typeName="Magic Armour" hidden="false" id="2554-f601-7937-31ad">
      <characteristics>
        <characteristic name="Description" typeId="d6b2-9b2a-d88e-eec9">The wearer counts as wearing light armour.
Enemy models suffer a –1 modifier to hit when making shooting attacks or close combat attacks against the wearer.
In addition, the wearer and any unit the wearer has joined have the Magic Resistance (1) special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Earth-Blessed Clay Armour" typeId="fefe-6a57-a203-edf9" typeName="Magic Armour" hidden="false" id="15f5-571f-07c7-4e7e">
      <characteristics>
        <characteristic name="Description" typeId="d6b2-9b2a-d88e-eec9">The wearer counts as wearing light armour. The wearer has the Regeneration (4+) special rule. It also gains the Flammable special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Supreme Rhino Horn" typeId="5c1d-13f3-7dd6-e817" typeName="Talismans" hidden="false" id="37ae-41ed-7f40-0fe9">
      <characteristics>
        <characteristic name="Description" typeId="3fa5-c856-b00a-c9f4">The wielder of the Supreme Rhino Horn and the unit the wearer has joined gain the Impact Hits (1) special rule. 
If the wielder or the unit already had this special rule, increment in (1) the modifier of the Impact Hits.</characteristic>
      </characteristics>
    </profile>
    <profile name="Pearl of the Origins" typeId="5c1d-13f3-7dd6-e817" typeName="Talismans" hidden="false" id="be17-9648-6210-4e92">
      <characteristics>
        <characteristic name="Description" typeId="3fa5-c856-b00a-c9f4">The bearer of the Pearl of the Origins has a 3+ Ward save against any wound that would cause them to lose their last Wound. 
This applies even if the case of inflicting Multiple Wounds.</characteristic>
      </characteristics>
    </profile>
    <profile name="Standard of Carrion" typeId="e3be-1b80-f570-96a1" typeName="Magic Standards" hidden="false" id="dd9a-5f20-1ea7-7af0">
      <characteristics>
        <characteristic name="Description" typeId="a34c-cc25-6cb9-95e1">Any enemy unit becomes subject to the Impetuous special rule whenever it is within charge range of a unit carrying the Standard of Carrion, except ‘light infantry’ and ‘heavy infantry’ troop types.</characteristic>
      </characteristics>
    </profile>
    <profile name="Banner of the Calming Miasma" typeId="e3be-1b80-f570-96a1" typeName="Magic Standards" hidden="false" id="5ac1-6ce3-ce37-5c79">
      <characteristics>
        <characteristic name="Description" typeId="a34c-cc25-6cb9-95e1">Any friendly unit within the command range of a unit carrying this standard may attempt a Leadership test to resist the effects of Frenzy when required to declare a charge. 
If the test is passed, the unit does not have to declare the charge.
In addition, friendly units within 6&quot; of a unit carrying this standard may re-roll failed Leadership tests taken for the Impetuous special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Banner of the Nomad Tribes" typeId="e3be-1b80-f570-96a1" typeName="Magic Standards" hidden="false" id="5a41-4fdf-1bc3-6b67">
      <characteristics>
        <characteristic name="Description" typeId="a34c-cc25-6cb9-95e1">A unit carrying the Banner of the Nomad Tribes gains the Reserve Move special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Standard of Quiet Spirits" typeId="e3be-1b80-f570-96a1" typeName="Magic Standards" hidden="false" id="cc6d-2ab5-c6fe-68ef">
      <characteristics>
        <characteristic name="Description" typeId="a34c-cc25-6cb9-95e1">A unit carrying this standard gains a +1 bonus to its Combat Result for each enemy unit with the Monster troop type it is engaged with.</characteristic>
      </characteristics>
    </profile>
    <profile name="Milenary Limb" typeId="65d6-7512-2a53-bd6c" typeName="Arcane Items" hidden="false" id="1e55-2e5f-572b-a233">
      <characteristics>
        <characteristic name="Description" typeId="fdd8-b367-1d68-c9cd">The Bearer of the Millenary Limb gains +1 to Dispel rolls while within 8&quot; of a natural terrain feature (excluding buildings and artificial terrain).</characteristic>
      </characteristics>
    </profile>
    <profile name="Amulet of Absence" typeId="d29c-a3fb-dcdf-29d6" typeName="Enchanted Items" hidden="false" id="2a22-0057-8a8d-e972">
      <characteristics>
        <characteristic name="Description" typeId="cea7-7573-475d-cc1d">If attacked by a magic weapon, both by shooting attacks or in close combat, the Amulet of Absence negates its Special Rules. 
Only consider the Strength and Armour Penetration values of the magic weapon.</characteristic>
      </characteristics>
    </profile>
    <profile name="Ethernal Heart" typeId="65d6-7512-2a53-bd6c" typeName="Arcane Items" hidden="false" id="0ef9-4677-3936-cf05">
      <characteristics>
        <characteristic name="Description" typeId="fdd8-b367-1d68-c9cd">Single use. During the Command sub-phase of their turn, the bearer of the Ethereal Heart may consume it. 
Until the end of this turn, any friendly unit within the command range of the bearer gains the Fly (X) Special Rule, where X is the movement characteristic of each unit.</characteristic>
      </characteristics>
    </profile>
    <profile name="Zebra Mane" typeId="d29c-a3fb-dcdf-29d6" typeName="Enchanted Items" hidden="false" id="c069-3214-e3b3-8f4d">
      <characteristics>
        <characteristic name="Description" typeId="cea7-7573-475d-cc1d">Single Use. During the Command phase, a unit may consume the Zebra Mane. 
Until the start of its next turn, that unit gains the Feigned Flight special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Gem of the Void Drawn" typeId="d29c-a3fb-dcdf-29d6" typeName="Enchanted Items" hidden="false" id="3119-d297-e3dc-922c">
      <characteristics>
        <characteristic name="Description" typeId="cea7-7573-475d-cc1d">Whenever the Bearer makes a Perfect Invocation in a Dispel roll, inflicts a single Strength 6 AP-2 hit on each other Wizard (friend or foe) at 24”</characteristic>
      </characteristics>
    </profile>
    <profile name="Scurry Away" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="9f64-4bf9-7f90-5f29">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">Models with this special rule have a +1 modifier to the result of any Flee roll they make.</characteristic>
      </characteristics>
    </profile>
