    <profile name="Primeval Agility" hidden="false" id="b825-1f99-536c-d752" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">An enemy model suffers a -1 modifier to Hit against a model with this special rule during the first round of any combat.</characteristic>
      </characteristics>
    </profile>
